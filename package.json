{
  "name": "dozokit-ideas",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "dev:worker": "vite build && wrangler dev --port 8787 --test-scheduled",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "license": "AGPL-3.0-only",
  "cloudflare": {
    "bindings": {
      "PASSWORD": {
        "description": "The password to sign in to your boards' admin page, 12 characters or more."
      },
      "DB": {
        "description": "Where boards, ideas, votes and comments are kept."
      },
      "BACKUPS": {
        "description": "Where the weekly backup of your boards is kept. Keep this bucket private."
      }
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "workerd@1.20261023.1": true
  }
}
