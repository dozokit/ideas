{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dozokit-ideas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The update check (dozokit.com) is the only call to the public internet.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Pages and data go to the Worker; the built files (/assets/*, icon.svg) are served straight by
  // Cloudflare, so they don't count toward the free plan's 100,000 requests a day.
  "assets": { "binding": "ASSETS", "run_worker_first": ["/", "/b/*", "/admin", "/admin/*", "/api/*", "/sso", "/robots.txt"] },
  // No database_id: the Deploy button creates the database, or `wrangler d1 create` adds it here.
  "d1_databases": [{ "binding": "DB", "database_name": "dozokit-ideas", "migrations_dir": "migrations" }],
  // A copy of every board on Sundays at 03:00 UTC, the last 4 kept. Keep this bucket private: backups hold signed-link secrets.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "dozokit-ideas-backups" }],
  "triggers": { "crons": ["0 3 * * SUN"] },
  // Admin sign-in and signed-link attempts per address. namespace_id only has to be unique in your Cloudflare account: change it if it clashes.
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "7312", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
